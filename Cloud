<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cloud — republicka.life</title>
    <meta name="description" content="Cloud — the distributed file archive of Republicka. Browse, search, preview, and download. CC0 forever.">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;900&family=Share+Tech+Mono&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root{
            --font-display: 'Orbitron', sans-serif;
            --font-mono-ui: 'JetBrains Mono', monospace;
            --radius-seal: 999px;
            --ease: cubic-bezier(.22,.9,.34,1);
        }

        /* ══ THEME TOKENS — Cloud, tech cyan/blue palette ══ */
        [data-theme="light"] {
            --gold:         #0891b2;
            --gold2:        #0e7490;
            --gold3:        #0369a1;
            --gold4:        #64748b;
            --bg:           #f7fafc;
            --surface:      rgba(8,145,178,0.045);
            --surface-hover:rgba(8,145,178,0.10);
            --surface-open: rgba(8,145,178,0.07);
            --file-bg:      rgba(15,23,42,0.02);
            --file-hover:   rgba(8,145,178,0.08);
            --border:       rgba(3,105,161,0.18);
            --border-dim:   rgba(3,105,161,0.12);
            --border-dir:   rgba(3,105,161,0.26);
            --grid-line:    rgba(3,105,161,0.045);
            --input-bg:     rgba(255,255,255,0.92);
            --btn-bg:       rgba(8,145,178,0.07);
            --btn-hover:    rgba(8,145,178,0.16);
            --copy-hover:   rgba(8,145,178,0.09);
            --copy-border:  rgba(8,145,178,0.32);
            --green:        #0e9f6e;
            --green-bg:     rgba(14,159,110,0.08);
            --green-border: rgba(14,159,110,0.38);
            --hl-bg:        rgba(8,145,178,0.16);
            --state-bg:     rgba(0,0,0,0.05);
            --nebula1:      rgba(8,145,178,0.10);
            --nebula2:      rgba(14,116,144,0.07);
            --player-bg:    rgba(255,255,255,0.97);
            --player-track: rgba(3,105,161,0.15);
            --shadow-glow:  0 0 8px rgba(8,145,178,0.3);
            --shadow-glow2: drop-shadow(0 0 16px rgba(8,145,178,0.45));
            --text-shadow:  0 0 14px rgba(8,145,178,0.14), 1px 1px 0 rgba(255,255,255,0.6);
            --focus-glow:   0 0 14px rgba(8,145,178,0.18);
        }

        [data-theme="dark"] {
            --gold:         #22d3ee;
            --gold2:        #7dd3fc;
            --gold3:        #06b6d4;
            --gold4:        #5b7a8a;
            --bg:           #030711;
            --surface:      rgba(34,211,238,0.05);
            --surface-hover:rgba(34,211,238,0.10);
            --surface-open: rgba(34,211,238,0.075);
            --file-bg:      rgba(255,255,255,0.012);
            --file-hover:   rgba(34,211,238,0.09);
            --border:       rgba(34,211,238,0.22);
            --border-dim:   rgba(6,182,212,0.22);
            --border-dir:   rgba(6,182,212,0.34);
            --grid-line:    rgba(34,211,238,0.025);
            --input-bg:     rgba(0,10,20,0.6);
            --btn-bg:       rgba(34,211,238,0.09);
            --btn-hover:    rgba(34,211,238,0.18);
            --copy-hover:   rgba(34,211,238,0.1);
            --copy-border:  rgba(34,211,238,0.35);
            --green:        #4ade80;
            --green-bg:     rgba(74,222,128,0.08);
            --green-border: rgba(74,222,128,0.42);
            --hl-bg:        rgba(34,211,238,0.14);
            --state-bg:     rgba(0,0,0,0.4);
            --nebula1:      rgba(6,182,212,0.22);
            --nebula2:      rgba(8,47,73,0.35);
            --player-bg:    rgba(3,8,16,0.97);
            --player-track: rgba(34,211,238,0.16);
            --shadow-glow:  0 0 8px rgba(34,211,238,0.45);
            --shadow-glow2: drop-shadow(0 0 22px rgba(34,211,238,0.9)) drop-shadow(0 0 46px rgba(6,182,212,0.35));
            --text-shadow:  0 0 18px rgba(34,211,238,0.4), 1px 1px 0 rgba(0,0,0,0.9);
            --focus-glow:   0 0 14px rgba(34,211,238,0.18);
        }

        [data-theme="party"] {
            --gold:         #00e5ff;
            --gold2:        #ff2fe0;
            --gold3:        #39ff14;
            --gold4:        #b98cff;
            --bg:           #04010b;
            --surface:      rgba(0,229,255,0.06);
            --surface-hover:rgba(0,229,255,0.12);
            --surface-open: rgba(0,229,255,0.09);
            --file-bg:      rgba(255,255,255,0.015);
            --file-hover:   rgba(255,47,224,0.09);
            --border:       rgba(0,229,255,0.4);
            --border-dim:   rgba(0,229,255,0.24);
            --border-dir:   rgba(255,47,224,0.36);
            --grid-line:    rgba(0,229,255,0.035);
            --input-bg:     rgba(10,0,25,0.6);
            --btn-bg:       rgba(0,229,255,0.14);
            --btn-hover:    rgba(0,229,255,0.26);
            --copy-hover:   rgba(255,47,224,0.14);
            --copy-border:  rgba(255,47,224,0.4);
            --green:        #39ff14;
            --green-bg:     rgba(57,255,20,0.09);
            --green-border: rgba(57,255,20,0.45);
            --hl-bg:        rgba(0,229,255,0.18);
            --state-bg:     rgba(0,0,0,0.4);
            --nebula1:      rgba(0,229,255,0.22);
            --nebula2:      rgba(255,47,224,0.14);
            --player-bg:    rgba(6,0,18,0.97);
            --player-track: rgba(0,229,255,0.22);
            --shadow-glow:  0 0 10px rgba(0,229,255,0.55);
            --shadow-glow2: drop-shadow(0 0 22px rgba(0,229,255,0.9)) drop-shadow(0 0 46px rgba(255,47,224,0.35));
            --text-shadow:  0 0 18px rgba(0,229,255,0.4), 1px 1px 0 rgba(0,0,0,0.9);
            --focus-glow:   0 0 14px rgba(0,229,255,0.22);
        }
        [data-theme="party"] body { animation: party-bg 6s linear infinite; }
        @keyframes party-bg{
            0%{background-color:#04010b;} 16%{background-color:#0a0012;} 33%{background-color:#00100f;}
            50%{background-color:#04010b;} 66%{background-color:#10000c;} 83%{background-color:#05010f;}
            100%{background-color:#04010b;}
        }
        [data-theme="party"] header {
            animation: party-border 2s linear infinite;
        }
        [data-theme="party"] .site-name {
            animation: party-flash 1.5s linear infinite;
        }
        @keyframes party-flash{
            0%{color:#00e5ff; text-shadow:0 0 18px rgba(0,229,255,.9);}
            25%{color:#ff2fe0; text-shadow:0 0 18px rgba(255,47,224,.9);}
            50%{color:#39ff14; text-shadow:0 0 18px rgba(57,255,20,.9);}
            75%{color:#ffea00; text-shadow:0 0 18px rgba(255,234,0,.9);}
            100%{color:#00e5ff; text-shadow:0 0 18px rgba(0,229,255,.9);}
        }
        @keyframes party-border{
            0%{border-color:#00e5ff;} 25%{border-color:#ff2fe0;} 50%{border-color:#39ff14;}
            75%{border-color:#ffea00;} 100%{border-color:#00e5ff;}
        }
        [data-theme="party"] .btn,
        [data-theme="party"] .theme-btn {
            animation: party-border 2s linear infinite;
        }
        [data-theme="party"] .entry.file:hover {
            background: rgba(0,229,255,0.15);
            border-left-color: #00e5ff;
        }

        body {
            background: var(--bg);
            color: var(--gold2);
            font-family: 'Share Tech Mono', monospace;
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.3s, color 0.3s;
        }

        body::before {
            content: '';
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 70% 40% at 15% 10%, var(--nebula1) 0%, transparent 60%),
                radial-gradient(ellipse 50% 60% at 85% 80%, var(--nebula2) 0%, transparent 55%);
        }
        body::after {
            content: '';
            position: fixed; inset: 0; z-index: 1; pointer-events: none;
            background-image:
                linear-gradient(var(--grid-line) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* ══ REPUBLICKA TASKBAR / START MENU ══ */
        .taskbar{
            position:fixed; top:0; left:0; right:0; z-index:200;
            display:flex; align-items:center; justify-content:space-between;
            padding:12px 22px;
            background:var(--player-bg);
            backdrop-filter:blur(14px) saturate(140%);
            border-bottom:1px solid var(--border);
        }
        .wordmark{
            display:flex; align-items:center; gap:10px;
            font-family:var(--font-display);
            font-weight:700; font-size:16px; letter-spacing:.08em; text-transform:uppercase;
            color: var(--gold);
        }
        .wordmark .crest{width:24px; height:24px; flex:none;}
        .wordmark span small{
            display:block; font-family:var(--font-mono-ui); font-size:9px; letter-spacing:.14em;
            color:var(--gold4); text-transform:none; font-weight:500; margin-top:1px;
        }
        .taskbar-right{display:flex; align-items:center; gap:10px;}
        .theme-switch{
            display:flex; gap:4px;
            background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-seal); padding:3px;
        }
        .theme-switch button{
            appearance:none; border:none; cursor:pointer;
            width:32px; height:32px; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            font-size:14px; background:transparent; color:var(--gold4);
            transition:background .25s var(--ease), color .25s var(--ease);
        }
        .theme-switch button[aria-pressed="true"]{background:var(--gold); color:var(--bg);}
        .start-btn{
            appearance:none; cursor:pointer;
            display:flex; align-items:center; gap:9px;
            padding:8px 16px 8px 10px;
            background:linear-gradient(180deg, var(--gold3) 0%, var(--gold2) 100%);
            color:#f2fbff; border:none; border-radius:var(--radius-seal);
            font-family:var(--font-mono-ui); font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase;
            box-shadow:0 6px 16px -6px rgba(0,0,0,.4);
        }
        .start-btn .flag{ width:18px; height:18px; border-radius:50%; background:conic-gradient(from 180deg, var(--gold), var(--gold3), var(--green), var(--gold)); flex:none; }

        .menu-scrim{
            position:fixed; inset:0; z-index:210;
            background:rgba(4,8,14,.5); backdrop-filter:blur(2px);
            opacity:0; pointer-events:none; transition:opacity .3s var(--ease);
        }
        .menu-scrim.open{opacity:1; pointer-events:auto;}
        .start-menu{
            position:fixed; z-index:220; left:16px; bottom:16px;
            width:min(460px, calc(100vw - 32px));
            background:var(--player-bg);
            backdrop-filter:blur(20px) saturate(160%);
            border:1px solid var(--border); border-radius:14px;
            box-shadow: 0 20px 60px -18px rgba(0,0,0,.5);
            padding:20px;
            transform:translateY(16px) scale(.98); opacity:0; pointer-events:none;
            transition:transform .32s var(--ease), opacity .32s var(--ease);
        }
        .start-menu.open{transform:translateY(0) scale(1); opacity:1; pointer-events:auto;}
        .start-menu-head{
            display:flex; align-items:baseline; justify-content:space-between;
            margin-bottom:14px; padding-bottom:12px; border-bottom:1px solid var(--border);
            font-family:var(--font-mono-ui); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--gold4);
        }
        .start-menu-head strong{ color:var(--gold); font-size:14px; letter-spacing:.1em; }
        .tiles{display:grid; grid-template-columns:repeat(3, 1fr); gap:8px;}
        .tile{
            display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
            padding:14px 6px 12px;
            background:var(--surface); border:1px solid var(--border); border-radius:10px;
            cursor:pointer; text-align:center; text-decoration:none;
            transition:background .2s var(--ease), color .2s var(--ease);
        }
        .tile:hover{background:var(--gold); color:var(--bg);}
        .tile .ic{font-size:20px; line-height:1;}
        .tile .lb{font-family:var(--font-mono-ui); font-size:10px; letter-spacing:.03em; text-transform:uppercase; color:inherit;}
        .start-menu-foot{
            margin-top:14px; padding-top:12px; border-top:1px solid var(--border);
            font-family:var(--font-mono-ui); font-size:10px; color:var(--gold4);
            display:flex; justify-content:space-between; letter-spacing:.04em;
        }

        .page { position: relative; z-index: 10; max-width: 1100px; margin: 0 auto; padding: 96px 28px 120px; }

        /* ── HEADER ── */
        header {
            padding: 44px 0 32px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 36px;
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 20px;
        }
        .site-id { display: flex; align-items: center; gap: 16px; }
        .logo { display:inline-flex; font-size: 36px; color: var(--gold); animation: pulse 5s ease-in-out infinite; }
        .logo svg { width: 1em; height: 0.67em; display: block; }
        @keyframes pulse {
            0%,100% { filter: var(--shadow-glow); }
            50%      { filter: var(--shadow-glow2); }
        }
        .site-name {
            font-family: var(--font-display); font-size: clamp(16px,3vw,26px); font-weight: 900;
            letter-spacing: 5px; color: var(--gold); text-shadow: var(--text-shadow); line-height: 1.1;
        }
        .site-tagline { font-size: 11px; color: var(--gold4); letter-spacing: 3px; margin-top: 4px; }

        /* ── TOOLBAR ── */
        .toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        #searchInput {
            background: var(--input-bg); border: 1px solid var(--border);
            color: var(--gold); font-family: 'Share Tech Mono', monospace;
            font-size: 13px; padding: 8px 14px; width: 240px; outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        #searchInput::placeholder { color: var(--gold4); }
        #searchInput:focus { border-color: var(--gold3); box-shadow: var(--focus-glow); }

        .btn {
            background: var(--btn-bg); border: 1px solid var(--border); color: var(--gold3);
            font-family: 'Share Tech Mono', monospace; font-size: 12px; letter-spacing: 1px;
            padding: 8px 16px; cursor: pointer; transition: all 0.18s; white-space: nowrap;
        }
        .btn:hover { background: var(--btn-hover); border-color: var(--gold3); color: var(--gold); }

        .theme-btn {
            background: var(--btn-bg); border: 1px solid var(--border); color: var(--gold3);
            font-family: 'Share Tech Mono', monospace; font-size: 12px; letter-spacing: 1px;
            padding: 8px 14px; cursor: pointer; transition: all 0.18s; white-space: nowrap;
            display: flex; align-items: center; gap: 6px;
        }
        .theme-btn:hover { background: var(--btn-hover); border-color: var(--gold3); color: var(--gold); }

        /* ── STATS ── */
        .stats { font-size: 12px; color: var(--gold4); padding: 10px 0 18px; letter-spacing: 1px; border-bottom: 1px solid var(--border); margin-bottom: 16px; }
        .stats strong { color: var(--gold3); }

        /* ── TREE ── */
        #explorer { display: flex; flex-direction: column; gap: 2px; }
        .entry {
            display: grid; align-items: center; padding: 9px 14px;
            border-left: 2px solid transparent;
            transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
        }
        .entry.dir {
            grid-template-columns: 20px 1fr auto; gap: 0 10px;
            background: var(--surface); border-left-color: var(--border-dir);
            color: var(--gold2); cursor: pointer;
        }
        .entry.dir:hover { background: var(--surface-hover); border-left-color: var(--gold3); color: var(--gold); }
        .entry.dir.open  { background: var(--surface-open);  border-left-color: var(--gold3); color: var(--gold); }

        /* file: icon | name | play | copy | meta */
        .entry.file {
            grid-template-columns: 20px 1fr auto auto auto; gap: 0 8px;
            background: var(--file-bg); border-left-color: var(--border-dim);
            color: var(--gold3); text-decoration: none; cursor: pointer;
        }
        .entry.file:hover { background: var(--file-hover); border-left-color: var(--gold2); color: var(--gold); transform: translateX(3px); }
        .entry.file:hover .entry-meta { color: var(--green); }

        .entry-icon { font-size: 13px; text-align: center; }
        .entry-name { font-size: 13px; letter-spacing: 0.2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .entry-meta { font-size: 11px; color: var(--gold4); white-space: nowrap; text-align: right; transition: color 0.15s; }

        /* ── ACTION BUTTONS (play + copy) ── */
        .file-action-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 24px; height: 24px; background: none; border: 1px solid transparent;
            border-radius: 3px; cursor: pointer; font-size: 12px; line-height: 1;
            transition: all 0.15s; flex-shrink: 0; color: var(--gold4);
        }
        .file-action-btn:hover { color: var(--gold); border-color: var(--copy-border); background: var(--copy-hover); }
        .file-action-btn.copied { color: var(--green); border-color: var(--green-border); background: var(--green-bg); }
        .file-action-btn.play-btn-inline:hover { color: var(--gold); }

        /* depth */
        .entry[data-depth="1"] { padding-left: 30px; }
        .entry[data-depth="2"] { padding-left: 48px; }
        .entry[data-depth="3"] { padding-left: 66px; }
        .entry[data-depth="4"] { padding-left: 84px; }
        .entry[data-depth="5"] { padding-left: 102px; }
        .entry[data-depth="6"] { padding-left: 120px; }

        .chevron { display: inline-block; font-size: 9px; transition: transform 0.18s; color: var(--gold4); }
        .entry.dir.open .chevron { transform: rotate(90deg); color: var(--gold3); }
        .dir-children { overflow: hidden; transition: max-height 0.22s ease; }
        .dir-children.collapsed { max-height: 0 !important; }

        /* ── SEARCH RESULTS ── */
        #searchResults { display: none; flex-direction: column; gap: 2px; }
        #searchResults.active { display: flex; }
        #explorer.hidden { display: none; }

        .search-match {
            display: grid; grid-template-columns: 20px 1fr auto auto auto; gap: 0 8px;
            align-items: center; padding: 9px 14px;
            background: var(--file-bg); border-left: 2px solid var(--border-dim);
            color: var(--gold3); text-decoration: none; font-size: 13px; transition: all 0.15s; cursor: pointer;
        }
        .search-match:hover { background: var(--file-hover); border-left-color: var(--gold2); color: var(--gold); transform: translateX(3px); }
        .search-match:hover .match-ext { color: var(--green); }
        .match-path { font-size: 11px; color: var(--gold4); display: block; margin-top: 2px; }
        .match-ext  { font-size: 11px; color: var(--gold4); white-space: nowrap; }
        em.hl { font-style: normal; color: var(--gold); background: var(--hl-bg); padding: 0 2px; }

        /* ── STATE ── */
        .state-msg { text-align: center; padding: 70px 20px; font-size: 15px; color: var(--gold3); font-family: 'Share Tech Mono', monospace; letter-spacing: 0.5px; }
        .state-msg .big { font-size: 48px; display: block; margin-bottom: 16px; }
        .state-msg code { font-family: 'JetBrains Mono', monospace; font-size: 13px; background: var(--state-bg); padding: 2px 8px; color: var(--green); font-style: normal; }

        /* ── FOOTER ── */
        footer { text-align: center; margin-top: 70px; padding-top: 28px; border-top: 1px solid var(--border); font-size: 11px; color: var(--gold3); letter-spacing: 3px; line-height: 2.4; }

        /* ════════════════════════════════════════
           MEDIA PLAYER
        ════════════════════════════════════════ */
        #mediaPlayer {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;
            background: var(--player-bg);
            border-top: 2px solid var(--gold3);
            padding: 0;
            transform: translateY(100%);
            transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
            backdrop-filter: blur(12px);
            box-shadow: 0 -4px 40px rgba(0,0,0,0.5);
        }
        #mediaPlayer.open { transform: translateY(0); }

        /* video modal overlay */
        #videoOverlay {
            display: none; position: fixed; inset: 0; z-index: 999;
            background: rgba(0,0,0,0.88); align-items: center; justify-content: center;
        }
        #videoOverlay.open { display: flex; }
        #videoOverlay video {
            max-width: 90vw; max-height: 80vh; border: 2px solid var(--gold3);
            box-shadow: 0 0 40px rgba(0,0,0,0.8);
        }
        .overlay-close {
            position: absolute; top: 20px; right: 26px;
            background: none; border: 1px solid var(--gold3);
            color: var(--gold); font-size: 20px; width: 38px; height: 38px;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
        }
        .overlay-close:hover { background: var(--btn-hover); }

        /* image overlay */
        #imageOverlay {
            display: none; position: fixed; inset: 0; z-index: 999;
            background: rgba(0,0,0,0.92); align-items: center; justify-content: center;
            flex-direction: column; gap: 16px;
        }
        #imageOverlay.open { display: flex; }
        #imageOverlay img {
            max-width: 90vw; max-height: 82vh;
            border: 2px solid var(--gold3);
            box-shadow: 0 0 60px rgba(0,0,0,0.9);
            object-fit: contain;
        }
        #imageOverlayName {
            font-family: var(--font-display); font-size: 12px; color: var(--gold3);
            letter-spacing: 0.1em;
        }

        /* player bar */
        .player-bar {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 0;
